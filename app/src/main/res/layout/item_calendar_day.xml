<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCalendarDay"
    android:layout_width="60.dp"
    android:layout_height="75.dp"
    android:layout_margin="4.dp"
    app:cardCornerRadius="12.dp"
    app:cardElevation="2.dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1.dp"
    app:strokeColor="@color/light_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6.dp">

        <TextView
            android:id="@+id/tvDayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12.sp"
            android:textStyle="bold"
            android:textColor="@color/green_light" />

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18.sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:layout_marginTop="2.dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
